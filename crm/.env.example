DATABASE_URL="postgresql://user:password@localhost:5432/crm"

# Shared password gate for the whole app (see src/proxy.ts).
APP_PASSWORD="choose-a-password"
# Random secret used to sign the login session cookie — generate with
# `openssl rand -base64 32`, or any long random string. Never reuse APP_PASSWORD here.
AUTH_SECRET="generate-a-long-random-string"
