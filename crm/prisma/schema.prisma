// Inflate AI CRM data model

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// The 5 active stages of the pipeline, in order, plus the post-win state.
// Won/Lost are outcomes (DealStatus), not stages — a deal is marked won or
// lost from whichever stage it was in. Marking a deal won automatically
// moves it into RELATIONSHIP_MANAGEMENT, which sits outside the active
// pipeline (it's not a column you drag a deal through).
enum DealStage {
  PROSPECT
  LEAD_QUALIFICATION
  MEETING
  PROPOSAL
  NEGOTIATION
  RELATIONSHIP_MANAGEMENT
}

// Outcome of a deal, independent of which stage it reached.
enum DealStatus {
  OPEN
  WON
  LOST
}

// Manually-assigned relationship health for a won account. Null means no
// tier has been set yet.
enum AccountHealth {
  HEALTHY
  AT_RISK
  CRITICAL
}

model Company {
  id        String   @id @default(cuid())
  name      String
  industry  String?
  website   String?
  phone     String?
  email     String?
  address   String?
  city      String?
  state     String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contacts     Contact[]
  hitListEntry HitListEntry?
}

// A contact IS the deal: every contact carries its own pipeline stage,
// status, and deal metadata rather than a separate Lead entity.
model Contact {
  id        String   @id @default(cuid())
  firstName String
  lastName  String
  email     String?
  phone     String?
  title     String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  stage        DealStage  @default(PROSPECT)
  status       DealStatus @default(OPEN)
  source       String?
  jobsPerMonth Float?
  pricePerHl   Float?

  // Business-meaning date (distinct from stage-history timestamps, so a
  // meeting can be scheduled ahead of the stage actually changing).
  appointmentDate DateTime?
  lostReason      String?
  closedAt        DateTime?

  // Fixed outreach cadence checklist (see src/lib/touchPoints.ts for the
  // day/label copy). Each is null until checked, then holds the date it
  // was logged done.
  touchCallTextAt DateTime?
  touchEmailAt    DateTime?
  touchLinkedinAt DateTime?
  touchDropInAt   DateTime?
  touchCallAt     DateTime?
  touchTextAt     DateTime?
  touchBreakupAt  DateTime?

  // Set when "Schedule First Touch Call" books a Mon/Fri 9:30-10:30 slot for
  // the still-unchecked Call+Text touch point. Purely a local booking record
  // (this app has no read access to any real calendar) — used to keep two
  // contacts from landing in the same 5-minute slot.
  firstTouchScheduledAt DateTime?

  // Relationship health tier, relevant once the account is won.
  healthTier AccountHealth?

  stageHistory    StageHistoryEntry[]
  journalEntries  JournalEntry[]
  reminders       Reminder[]
  onboardingFiles OnboardingFile[]

  @@index([companyId])
  @@index([stage])
}

// Every stage transition is recorded here, giving an accurate audit trail
// and the source of truth for cycle-time analytics (time between transitions).
model StageHistoryEntry {
  id        String    @id @default(cuid())
  contactId String
  contact   Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  fromStage DealStage?
  toStage   DealStage
  changedAt DateTime  @default(now())

  @@index([contactId])
}

// A follow-up reminder for a contact — used for scheduling future
// touch points and interactions, most relevant once a deal is won and the
// contact moves into relationship management.
model Reminder {
  id          String    @id @default(cuid())
  contactId   String
  contact     Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  note        String
  dueAt       DateTime
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([contactId])
  @@index([dueAt])
}

// Freeform touch-point log for a contact — calls, emails, meetings, etc.
// Independent of stage changes; entries are created and deleted directly.
model JournalEntry {
  id        String   @id @default(cuid())
  contactId String
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())

  @@index([contactId])
}

// A prospect list imported wholesale (not fed into the pipeline as
// contacts/deals) — company-level info only, for scanning through and
// logging a basic "I've reached out" touchpoint. Converting one creates a
// Company and hands off to the New Contact form to attach the actual
// person; the entry itself never becomes a Contact.
model HitListEntry {
  id          String    @id @default(cuid())
  companyName String
  website     String?
  phone       String?
  email       String?
  city        String?
  services    String?
  contactedAt DateTime?

  convertedCompanyId String?   @unique
  convertedCompany   Company?  @relation(fields: [convertedCompanyId], references: [id], onDelete: SetNull)
  convertedAt        DateTime?

  createdAt DateTime @default(now())

  @@index([companyName])
  @@index([contactedAt])
}

// Up to 5 tracked links per contact ("first 5 files") for shepherding a new
// client's earliest jobs — surfaced on the contact page once the deal
// reaches Negotiation, and gathered account-wide in the File Tracker tab,
// grouped into folders by company.
model OnboardingFile {
  id          String    @id @default(cuid())
  contactId   String
  contact     Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  label       String
  url         String
  position    Int
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([contactId])
}
