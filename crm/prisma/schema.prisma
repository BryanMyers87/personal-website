// Inflate AI CRM data model

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// The 5 active stages of the pipeline, in order. Won/Lost are outcomes
// (DealStatus), not stages — a deal is marked won or lost from whichever
// stage it was in, it doesn't advance through separate "won"/"lost" columns.
enum DealStage {
  PROSPECT
  LEAD_QUALIFICATION
  MEETING
  PROPOSAL
  NEGOTIATION
}

// Outcome of a deal, independent of which stage it reached.
enum DealStatus {
  OPEN
  WON
  LOST
}

model Company {
  id        String   @id @default(cuid())
  name      String
  industry  String?
  website   String?
  phone     String?
  email     String?
  address   String?
  city      String?
  state     String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contacts Contact[]
}

// A contact IS the deal: every contact carries its own pipeline stage,
// status, and deal metadata rather than a separate Lead entity.
model Contact {
  id        String   @id @default(cuid())
  firstName String
  lastName  String
  email     String?
  phone     String?
  title     String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  stage          DealStage  @default(PROSPECT)
  status         DealStatus @default(OPEN)
  source         String?
  estimatedValue Float?

  // Business-meaning date (distinct from stage-history timestamps, so a
  // meeting can be scheduled ahead of the stage actually changing).
  appointmentDate DateTime?
  lostReason      String?
  closedAt        DateTime?

  stageHistory StageHistoryEntry[]

  @@index([companyId])
  @@index([stage])
}

// Every stage transition is recorded here, giving an accurate audit trail
// and the source of truth for cycle-time analytics (time between transitions).
model StageHistoryEntry {
  id        String    @id @default(cuid())
  contactId String
  contact   Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  fromStage DealStage?
  toStage   DealStage
  changedAt DateTime  @default(now())

  @@index([contactId])
}
